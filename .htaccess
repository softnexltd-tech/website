# ═══════════════════════════════════════════════════════════
#  SoftNex Ltd STATIC SITE at ROOT (public_html)
#  Use this ONLY if the Softnex files sit directly inside
#  public_html and WordPress is NOT being used any more.
#  Clean URLs:  /products   instead of   /products.html
# ═══════════════════════════════════════════════════════════

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ── 1. Force HTTPS ─────────────────────────────────────────
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── 2. Force non-www  (delete these 2 lines if you want www) ─
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ── 3. Old  /products.html  →  /products   (301, SEO safe) ──
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ── 4. /index  or  /index.html  →  /  ──────────────────────
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# ── 5. Remove trailing slash (real folders excluded) ───────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ── 6. Internally serve the .html file for the clean URL ───
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ── 7. 404 page ────────────────────────────────────────────
ErrorDocument 404 /index.html

# ── 8. Browser caching ─────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

# ── 9. GZIP ────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
